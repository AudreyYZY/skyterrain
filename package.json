{
  "name": "flight-geography-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-cesium": "node scripts/copy-cesium.mjs",
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:regions": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-regions.ts",
    "check:camera": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-terrain-camera.ts",
    "check:places": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-places.ts",
    "check:routes": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-routes.ts",
    "check": "npm run check:content && npm run check:sentence-split && npm run check:highlight-sync && npm run typecheck && npm run lint && npm run check:regions && npm run check:camera && npm run check:places && npm run check:routes && npm run check:tts && npm run check:flight && npm run check:anchors && npm run check:claims",
    "check:tts": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-tts-cache.ts",
    "warm:tts": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/warm-tts.ts",
    "upload:tts-cache": "node --experimental-strip-types --env-file=.env.local --import ./scripts/ts-alias-loader.mjs scripts/upload-tts-cache.ts",
    "check:flight": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-route-flight.ts",
    "verify:apply": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/verify-apply.ts",
    "verify:report": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/verify-issues.ts",
    "check:claims": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-claims.ts",
    "check:anchors": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-route-anchors.ts",
    "gen:anchors": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/gen-route-anchors.ts",
    "verify:apply-text": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/verify-apply-text.ts",
    "list:claims": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/list-claims.ts",
    "check:zhen": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-zh-en-numbers.ts",
    "check:rvt": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-route-vs-terrain.ts",
    "check:distance": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-route-distance.ts",
    "check:pending": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-pending.ts",
    "check:airports": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-airports.ts",
    "check:bearings": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-bearings.ts",
    "check:issues": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-issues.ts",
    "sample:claims": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/sample-claims.ts",
    "gen:verify-status": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/gen-verification-status.ts",
    "check:layout-bearings": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-layout-bearings.ts",
    "gen:content": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/gen-content-index.ts",
    "check:content": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/gen-content-index.ts --check",
    "test:e2e": "playwright test",
    "check:sentence-split": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-sentence-split.ts",
    "check:highlight-sync": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-highlight-sync.ts",
    "check:batch": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-batch.ts",
    "gate": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/gate.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "cesium": "^1.141.0",
    "edge-tts-universal": "^1.4.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
