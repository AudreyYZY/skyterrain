{
  "name": "flight-geography-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-cesium": "node scripts/copy-cesium.mjs",
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:regions": "node --experimental-strip-types scripts/check-regions.ts",
    "check:camera": "node --experimental-strip-types scripts/check-terrain-camera.ts",
    "check:places": "node --experimental-strip-types scripts/check-places.ts",
    "check:routes": "node --experimental-strip-types scripts/check-routes.ts",
    "check": "npm run typecheck && npm run lint && npm run check:regions && npm run check:camera && npm run check:places && npm run check:routes && npm run check:tts && npm run check:flight",
    "check:tts": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-tts-cache.ts",
    "warm:tts": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/warm-tts.ts",
    "check:flight": "node --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/check-route-flight.ts"
  },
  "dependencies": {
    "cesium": "^1.141.0",
    "edge-tts-universal": "^1.4.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
